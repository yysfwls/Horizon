{
  "ai": {
    "provider": "deepseek",
    "model": "deepseek-flash",
    "base_url": "https://api.deepseek.com",
    "api_key_env": "DEEPSEEK_API_KEY",
    "temperature": 0.3,
    "max_tokens": 8192,
    "throttle_sec": 1,
    "languages": [
      "zh"
    ],
    "analysis_concurrency": 5,
    "enrichment_concurrency": 5
  },
  "processing": {
    "profiles_dir": "profiles",
    "default_profile": "ai-news",
    "profile_settings": {
      "ai-news": {
        "threshold": 7.0,
        "topic_dedup": true
      },
      "web-development": {
        "threshold": 6.0,
        "topic_dedup": true
      },
      "devtools-news": {
        "threshold": 6.0,
        "topic_dedup": true
      }
    }
  },
  "sources": {
    "github": [
      {
        "type": "user_events",
        "username": "karpathy",
        "enabled": true,
        "category": "ai",
        "profile": "ai-news"
      },
      {
        "type": "repo_releases",
        "owner": "vllm-project",
        "repo": "vllm",
        "enabled": true,
        "category": "ai",
        "profile": "ai-news"
      },
      {
        "type": "repo_releases",
        "owner": "sgl-project",
        "repo": "sglang",
        "enabled": true,
        "category": "ai",
        "profile": "ai-news"
      },
      {
        "type": "repo_releases",
        "owner": "triton-lang",
        "repo": "triton",
        "enabled": true,
        "category": "ai",
        "profile": "ai-news"
      },
      {
        "type": "repo_releases",
        "owner": "facebook",
        "repo": "react",
        "enabled": true,
        "category": "web-development",
        "profile": "web-development"
      },
      {
        "type": "repo_releases",
        "owner": "vercel",
        "repo": "next.js",
        "enabled": true,
        "category": "web-development",
        "profile": "web-development"
      },
      {
        "type": "repo_releases",
        "owner": "neovim",
        "repo": "neovim",
        "enabled": true,
        "category": "devtools",
        "profile": "devtools-news"
      },
      {
        "type": "repo_releases",
        "owner": "astral-sh",
        "repo": "uv",
        "enabled": true,
        "category": "devtools",
        "profile": "devtools-news"
      }
    ],
    "hackernews": {
      "enabled": true,
      "fetch_top_stories": 30,
      "min_score": 150,
      "profile": [
        "ai-news",
        "web-development",
        "devtools-news"
      ]
    },
    "rss": [
      {
        "name": "Simon Willison",
        "url": "https://simonwillison.net/atom/everything/",
        "enabled": true,
        "category": "ai",
        "profile": "ai-news"
      },
      {
        "name": "vLLM Blog",
        "url": "https://vllm.ai/blog/rss.xml",
        "enabled": true,
        "category": "ai",
        "profile": "ai-news",
        "content_extractor": "trafilatura"
      },
      {
        "name": "量子位",
        "url": "https://wechat2rss.xlab.app/feed/7131b577c61365cb47e81000738c10d872685908.xml",
        "enabled": true,
        "category": "ai",
        "profile": "ai-news"
      },
      {
        "name": "新智元",
        "url": "https://wechat2rss.xlab.app/feed/ede30346413ea70dbef5d485ea5cbb95cca446e7.xml",
        "enabled": true,
        "category": "ai",
        "profile": "ai-news"
      },
      {
        "name": "AIHOT 日报",
        "url": "https://aihot.news/feed/daily.xml",
        "enabled": true,
        "category": "ai",
        "profile": "ai-news"
      },
      {
        "name": "Semianalysis",
        "url": "https://newsletter.semianalysis.com/feed",
        "enabled": true,
        "category": "ai",
        "profile": "ai-news"
      },
      {
        "name": "CSS-Tricks",
        "url": "https://css-tricks.com/feed/",
        "enabled": true,
        "category": "web-development",
        "profile": "web-development",
        "content_extractor": "trafilatura"
      },
      {
        "name": "JavaScript Weekly",
        "url": "https://javascriptweekly.com/rss/",
        "enabled": true,
        "category": "web-development",
        "profile": "web-development"
      },
      {
        "name": "Frontend Focus",
        "url": "https://frontendfoc.us/rss/",
        "enabled": true,
        "category": "web-development",
        "profile": "web-development"
      },
      {
        "name": "Smashing Magazine",
        "url": "https://www.smashingmagazine.com/feed/",
        "enabled": true,
        "category": "web-development",
        "profile": "web-development",
        "content_extractor": "trafilatura"
      },
      {
        "name": "GitHub Trending - Daily",
        "url": "https://mshibanami.github.io/GitHubTrendingRSS/daily/all.xml",
        "enabled": true,
        "category": "devtools",
        "profile": "devtools-news"
      },
      {
        "name": "GitHub Changelog",
        "url": "https://github.blog/changelog/feed/",
        "enabled": true,
        "category": "devtools",
        "profile": "devtools-news"
      }
    ],
    "reddit": {
      "enabled": false,
      "subreddits": [
        {
          "subreddit": "MachineLearning",
          "enabled": true,
          "sort": "hot",
          "time_filter": "day",
          "fetch_limit": 10,
          "min_score": 60,
          "profile": "ai-news"
        },
        {
          "subreddit": "LocalLLaMA",
          "enabled": true,
          "sort": "hot",
          "time_filter": "day",
          "fetch_limit": 10,
          "min_score": 60,
          "profile": "ai-news"
        }
      ],
      "users": [],
      "fetch_comments": 10
    },
    "telegram": {
      "enabled": true,
      "channels": [
        {
          "channel": "zaihuapd",
          "enabled": true,
          "fetch_limit": 20,
          "category": "ai",
          "profile": "ai-news"
        }
      ]
    },
    "ossinsight": {
      "enabled": true,
      "period": "past_24_hours",
      "languages": ["All", "Python", "TypeScript"],
      "keywords": [],
      "min_stars": 10,
      "max_items": 20,
      "category": "devtools",
      "profile": "devtools-news"
    }
  },
  "collection": {
    "time_window_hours": 24
  },
  "digest": {
    "max_items": 10,
    "profile_order": [
      "ai-news",
      "web-development",
      "devtools-news"
    ],
    "group_by": "profile",
    "category_groups": {
      "ai": {
        "name": "AI",
        "limit": 4,
        "categories": ["ai-news"]
      },
      "web": {
        "name": "Web 开发",
        "limit": 3,
        "categories": ["web-development"]
      },
      "devtools": {
        "name": "开源 / 开发工具",
        "limit": 3,
        "categories": ["devtools-news"]
      }
    },
    "default_group": "other",
    "default_group_limit": 1
  },
  "webhook": {
    "enabled": true,
    "url_env": "HORIZON_WEBHOOK_URL",
    "delivery": "summary_and_items",
    "overview_position": "last",
    "platform": "feishu",
    "layout": "collapsible",
    "fallback_layout": "markdown",
    "languages": [
      "zh"
    ],
    "request_body": {
      "msg_type": "interactive",
      "card": {
        "schema": "2.0",
        "config": {
          "wide_screen_mode": true
        },
        "header": {
          "title": {
            "tag": "plain_text",
            "content": "#{message_title}"
          },
          "template": "blue"
        },
        "body": {
          "elements": [
            {
              "tag": "markdown",
              "content": "#{summary}"
            }
          ]
        }
      }
    },
    "headers": ""
  }
}
